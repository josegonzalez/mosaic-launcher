# Spanish for mosaic-launcher, from po/launcher.pot, and the localization
# plugin's own strings under msgctxt "localization".
# Strings left out (Bluetooth, Launcher, OK, PIN, Plugins, Pak Store, Wifi,
# the BRGHT and CLTMP abbreviations, SWITCHER and "%s %lld%%") show in
# English.
msgid ""
msgstr ""
"Project-Id-Version: mosaic-launcher\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

