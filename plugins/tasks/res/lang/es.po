msgid "%s (exit %d)"
msgstr "%s (salida %d)"

msgid "%s finished (exit %d)"
msgstr "%s terminó (salida %d)"

msgid "%s stopped"
msgstr "%s detenida"

msgid "%s was killed by signal %d"
msgstr "%s terminó por la señal %d"

msgid "A task is already running"
msgstr "Ya hay una tarea en marcha"

msgid "Couldn't run %s"
msgstr "No se pudo ejecutar %s"

msgid "Running... %lld:%02lld"
msgstr "En marcha... %lld:%02lld"

msgid "Runs shell scripts of your own from the Tasks folder on the card: from a Tasks folder on the first screen, or with Y for the selected game. Each one's last line of output shows when it ends."
msgstr "Ejecuta tus propios scripts de shell de la carpeta Tasks de la tarjeta: desde una carpeta Tareas en la primera pantalla, o con Y para el juego seleccionado. Al terminar, muestra la última línea de su salida."

msgid "Stopping... %lld:%02lld"
msgstr "Deteniendo... %lld:%02lld"

msgid "Tasks"
msgstr "Tareas"
