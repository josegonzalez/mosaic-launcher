+// mosaic: puts the theme slot's colours, background colour and font in
+// place, or stock's back, without touching stock's settings
+void GFX_themeChanged(void)
+{
+	Smooth_flush(); // the pill and button parts scaled to the old sizes
+	GFX_updateColors();
+	if (gfx.mode == MODE_MAIN)
