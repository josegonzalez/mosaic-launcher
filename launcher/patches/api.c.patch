+// mosaic: a pill part drawn h high is smooth-scaled (launcher/smooth.c)
+// when h is the theme's pill or button height, that size isn't stock's,
+// and the part isn't h high; any other is drawn as stock does
+static int GFX_pillScaled(SDL_Rect *rect, int h)
+{
+	return h != rect->h && ((h == SCALE1(PILL_SIZE) && PILL_SIZE != UI_stockPill()) ||
+							(h == SCALE1(BUTTON_SIZE) && BUTTON_SIZE != UI_stockButton()));
+}
+
+// mosaic: half of a pill's cap
+static void GFX_blitPillCap(int asset, int half, SDL_Surface *dst, int x, int y, int h, uint32_t asset_color)
+{
+	SDL_Rect *rect = &asset_rects[asset];
+	int r = h / 2;
+	SDL_Surface *cap = GFX_pillScaled(rect, h) ? Smooth_piece(gfx.assets, rect, r * 2, h) : NULL;
+	if (cap)
+		GFX_blitSurfaceColor(cap, &(SDL_Rect){half ? r : 0, 0, r, h}, dst, &(SDL_Rect){x, y}, asset_color);
+	else
+		GFX_blitAssetColor(asset, &(SDL_Rect){half ? r : 0, 0, r, h}, dst, &(SDL_Rect){x, y}, asset_color);
+}
+
+// mosaic: a pill's middle, scaled to its height as its caps are
+static void GFX_blitPillMiddle(SDL_Rect *src, SDL_Surface *dst, SDL_Rect *dst_rect, uint32_t color)
+{
+	SDL_Surface *middle = GFX_pillScaled(src, dst_rect->h) ? Smooth_piece(gfx.assets, src, src->w, dst_rect->h) : NULL;
+	GFX_blitSurfaceColorScaled(middle ? middle : gfx.assets, middle ? NULL : src, dst, dst_rect, color);
+}
+
+// mosaic: a button's circle or prompt at the theme's button size
+static void GFX_blitButtonAsset(SDL_Surface *sheet, SDL_Rect *src, SDL_Surface *dst, SDL_Rect *dst_rect, uint32_t asset_color)
+{
+	int size = SCALE1(BUTTON_SIZE), stock = SCALE1(UI_stockButton());
+	SDL_Surface *piece = size == stock ? NULL : Smooth_piece(sheet, src, src->w * size / stock, src->h * size / stock);
+	if (piece)
+		GFX_blitSurfaceColor(piece, NULL, dst, dst_rect, asset_color);
+	else
+		GFX_blitSurfaceColor(sheet, src, dst, dst_rect, asset_color);
+}
