+// mosaic: half of a pill's cap, scaled from the sheet's when it's drawn at
+// the theme's pill or button height; any other height is drawn as stock does
+static void GFX_blitPillCap(int asset, int half, SDL_Surface *dst, int x, int y, int h, uint32_t asset_color)
+{
+	SDL_Rect *rect = &asset_rects[asset];
+	int r = h / 2;
+	if (h == rect->h || (h != SCALE1(PILL_SIZE) && h != SCALE1(BUTTON_SIZE)))
+	{
+		GFX_blitAssetColor(asset, &(SDL_Rect){half ? r : 0, 0, r, h}, dst, &(SDL_Rect){x, y}, asset_color);
+		return;
+	}
+	int sr = rect->h / 2;
+	GFX_blitSurfaceColorScaled(gfx.assets, &(SDL_Rect){rect->x + (half ? sr : 0), rect->y, sr, rect->h}, dst, &(SDL_Rect){x, y, r, h}, asset_color);
+}
+
+// mosaic: a button's circle or prompt at the theme's button size
+static void GFX_blitButtonAsset(SDL_Surface *sheet, SDL_Rect *src, SDL_Surface *dst, SDL_Rect *dst_rect, uint32_t asset_color)
+{
+	int size = SCALE1(BUTTON_SIZE);
+	if (size == SCALE1(UI_stockButton()))
+		GFX_blitSurfaceColor(sheet, src, dst, dst_rect, asset_color);
+	else
+	{
+		int w = src->w * size / SCALE1(UI_stockButton());
+		int h = src->h * size / SCALE1(UI_stockButton());
+		GFX_blitSurfaceColorScaled(sheet, src, dst, &(SDL_Rect){dst_rect->x, dst_rect->y, w, h}, asset_color);
+	}
+}
